# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# repo-specific (kept from before scaffolding)
.superpowers/

# demo mode's local, file-backed PGlite database (lib/db/demo-db.ts) —
# generated/seeded on first run, machine-local, never something to commit.
.demo-db/

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — ignore all real env files, but keep the checked-in example
# committed so Moiz (and future builders) know which vars to fill in.
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
