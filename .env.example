# FleetIQ environment variables.
# Copy this file to .env.local and fill in real values — .env.local is
# gitignored so secrets never get committed. This file (.env.example) IS
# committed so anyone cloning the repo knows exactly which vars to set.

# Clerk (auth). From the Clerk dashboard → your app → API Keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
# Sends signed-out visitors to FleetIQ's own themed /sign-in page instead
# of Clerk's generic hosted Account Portal.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Neon Postgres connection string (pooled). From the Neon dashboard.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Anthropic API key, used for AI schedule/receipt extraction (lib/ai/client.ts).
ANTHROPIC_API_KEY=sk-ant-placeholder

# Vercel Blob read/write token, for receipt photo uploads.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_placeholder

# Public base URL of the deployed app (used for building absolute links,
# e.g. in emails or webhook callbacks). No trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000
